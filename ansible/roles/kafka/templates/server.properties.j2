broker.id={{ groups['Role_kafka'].index(inventory_hostname) + 1 }}

listeners=PLAINTEXT://{{ ansible_default_ipv4.address }}:9092
advertised.listeners=PLAINTEXT://{{ ansible_default_ipv4.address }}:9092

num.network.threads=3
num.io.threads=8
socket.send.buffer.bytes=102400
socket.receive.buffer.bytes=102400
socket.request.max.bytes=104857600

log.dirs={{ kafka_log_dir | default('/var/log/kafka') }}
num.partitions=3
num.recovery.threads.per.data.dir=1

{% if groups['Role_zookeeper'] is defined and groups['Role_zookeeper'] | length > 0 %}
zookeeper.connect={{ groups['Role_zookeeper'] | map('extract', hostvars, ['ansible_default_ipv4', 'address']) | join(':2181,') }}:2181
{% else %}
# Agar single node ya kafka broker 1 par hi zookeeper chal raha hai:
zookeeper.connect={{ hostvars[groups['Role_kafka'][0]]['ansible_default_ipv4']['address'] }}:2181
{% endif %}

zookeeper.connection.timeout.ms=18000