############################# Socket Server Settings #############################
broker.id={{ broker_id }}
port={{ kafka_port | default(9092) }}

listeners=PLAINTEXT://0.0.0.0:{{ kafka_port | default(9092) }}
advertised.listeners=PLAINTEXT://{{ ansible_default_ipv4.address }}:{{ kafka_port | default(9092) }}

num.network.threads=3
num.io.threads=8
socket.send.buffer.bytes=102400
socket.receive.buffer.bytes=102400
socket.request.max.bytes=104857600

############################# Log Basics #############################
log.dirs={{ kafka_data_dir | default('/var/lib/kafka-logs') }}
num.partitions={{ kafka_num_partitions | default(3) }}
num.recovery.threads.per.data.dir=1
default.replication.factor=1

############################# Log Retention #############################
log.retention.hours={{ kafka_log_retention_hours | default(168) }}
log.segment.bytes=1073741824
log.retention.check.interval.ms=300000

############################# Zookeeper Connection #############################
zookeeper.connect=127.0.0.1:2181
zookeeper.connection.timeout.ms=18000
group.initial.rebalance.delay.ms=0